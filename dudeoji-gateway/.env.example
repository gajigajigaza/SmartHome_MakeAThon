# Render에서 실행 중인 FastAPI의 센서 게이트웨이 WebSocket
DUDEOJI_WEBSOCKET_URL=wss://dudeoji-makerthon.onrender.com/ws/sensors

# 두더지 웹에 로그인한 사용자에게 속한 실제 장소 ID
DUDEOJI_PLACE_ID=1

# 현재 FastAPI 계약은 로그인 토큰 인증을 사용합니다.
# 실제 값은 .env에만 넣고 GitHub에 올리지 마세요.
DUDEOJI_AUTH_TOKEN=TOKEN_TO_BE_ADDED_LATER

# XIAO 펌웨어의 BLE_DEVICE_NAME과 같아야 합니다.
DUDEOJI_BLE_DEVICE_NAME=DUDEOJI-XIAO

DUDEOJI_BLE_SCAN_TIMEOUT=10
DUDEOJI_LOG_LEVEL=INFO

# BME280이 없을 때도 전체 센서 저장 경로를 시험하는 명시적 시연 옵션.
# true이면 아래 가상값을 실제 센서 기록처럼 전송하므로 최종 시연은 false입니다.
DUDEOJI_DEMO_FALLBACK_BME=false
DUDEOJI_DEMO_TEMPERATURE=25.0
DUDEOJI_DEMO_HUMIDITY=50.0
