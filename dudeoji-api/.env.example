# dudeoji-api/.env.example
# 실제 값은 .env에 넣고 커밋하지 마세요. 이 파일은 필요한 키 목록만 보여줍니다.

# Supabase (필수 — 없으면 db.py가 import 시점에 예외 발생)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 추가 CORS origin (선택)
FRONTEND_URL=

# 날씨/미세먼지 API
OPENWEATHER_API_KEY=
KMA_SERVICE_KEY=

# 카카오 로컬 API (장소 검색/geocode, 없으면 500)
KAKAO_REST_API_KEY=

# MQTT 게이트웨이 (선택 — MQTT_ENABLED=true일 때만 사용)
MQTT_ENABLED=false
# jh 수정함 - MQTT_BROKER_ADDRESS가 없으면 리스너를 시작하지 않음(예전엔
# test.mosquitto.org 공개 브로커로 기본 연결됐음 — 보안상 제거됨). 현장
# 브로커 주소를 여기 넣어야 함.
MQTT_BROKER_ADDRESS=
MQTT_BROKER_PORT=1883
# USERNAME/PASSWORD는 둘 다 있을 때만 사용(인증 없는 사설 브로커는 비워둬도 됨)
MQTT_USERNAME=
MQTT_PASSWORD=
# 아래 둘은 기본값이 있어 보통 안 바꿔도 됨
MQTT_TOPIC=smarthome/dudeoji/sensor
MQTT_CONTROL_TOPIC=smarthome/dudeoji/control
